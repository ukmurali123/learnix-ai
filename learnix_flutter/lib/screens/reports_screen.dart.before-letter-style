  // ---------- data helpers ----------
  Map<String, dynamic> get _summary => Map<String, dynamic>.from((_progress?['summary'] as Map?) ?? {});
  Map<String, dynamic> get _student => Map<String, dynamic>.from((_progress?['student'] as Map?) ?? {});
  List<Map<String, dynamic>> get _quizzes => [for (final q in (_progress?['quiz_attempts'] as List?) ?? []) Map<String, dynamic>.from(q as Map)];
  List<Map<String, dynamic>> get _labs => [for (final q in (_progress?['lab_runs'] as List?) ?? []) Map<String, dynamic>.from(q as Map)];
  List<Map<String, dynamic>> get _days => [for (final d in (_path?['days'] as List?) ?? []) Map<String, dynamic>.from(d as Map)];
  double _num(Object? v) => double.tryParse('${v ?? 0}') ?? 0;
  String get _name => '${_student['first_name'] ?? 'Your child'}';

  /// Quiz % over time (oldest first, last 12 attempts).
  List<double> get _trend {
    final q = [..._quizzes]..sort((a, b) => '${a['attempted_at']}'.compareTo('${b['attempted_at']}'));
    final last = q.length > 12 ? q.sublist(q.length - 12) : q;
    return [for (final x in last) _num(x['max_score']) > 0 ? _num(x['score']) / _num(x['max_score']) * 100 : 0];
  }

  /// Average quiz % per subject area.
  List<(String, double)> get _skills {
    final tot = <String, double>{}, max = <String, double>{};
    for (final q in _quizzes) {
      final c = '${q['category'] ?? 'Other'}';
      tot[c] = (tot[c] ?? 0) + _num(q['score']);
      max[c] = (max[c] ?? 0) + _num(q['max_score']);
    }
    final out = [for (final c in tot.keys) if ((max[c] ?? 0) > 0) (c, tot[c]! / max[c]! * 100)];
    out.sort((a, b) => b.$2.compareTo(a.$2));
    return out;
  }

  /// Per experiment: (title, tries, successes).
  List<(String, int, int)> get _labStats {
    final tries = <String, int>{}, ok = <String, int>{};
    for (final r in _labs) {
      final t = '${r['experiment_title'] ?? 'Experiment'}';
      tries[t] = (tries[t] ?? 0) + 1;
      if (r['success'] == true) ok[t] = (ok[t] ?? 0) + 1;
    }
    return [for (final t in tries.keys) (t, tries[t]!, ok[t] ?? 0)];
  }

  /// Most common lab mistakes.
  List<(String, int)> get _mistakes {
    final m = <String, int>{};
    for (final r in _labs) {
      final e = '${r['error_type'] ?? ''}';
      if (e.isEmpty || e == 'none' || e == 'null') continue;
      m[e] = (m[e] ?? 0) + 1;
    }
    final out = [for (final e in m.entries) (e.key, e.value)]..sort((a, b) => b.$2.compareTo(a.$2));
    return out.take(5).toList();
  }

