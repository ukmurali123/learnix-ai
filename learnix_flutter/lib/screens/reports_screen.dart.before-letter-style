  Future<void> _fetchParentReport() async {
    setState(() {
      _isLoadingParent = true;
      _parentLetter = null;
    });
    try {
      final res = await http.get(Uri.parse('${widget.baseUrl}/api/reports/parent/${widget.studentId}?language=$_parentLang')).timeout(const Duration(seconds: 60));
      if (res.statusCode == 200) {
        final data = jsonDecode(res.body) as Map<String, dynamic>;
        final report = data['report'];
        String formatted = '';
        if (report is Map) {
          final goal = report['next_week_goal'] ?? '';
          formatted = [report['greeting'] ?? '', report['note'] ?? '', if (goal.toString().isNotEmpty) 'Next week: $goal']
              .where((s) => s.toString().trim().isNotEmpty)
              .join('\n\n');
        } else if (report is String) {
          formatted = report;
        } else {
          formatted = (data['ai_letter'] ?? '').toString();
        }
        setState(() => _parentLetter = formatted);
      }
    } catch (e) {
      debugPrint('Error loading parent report: $e');
    } finally {
      if (_parentLetter == null || _parentLetter!.trim().isEmpty) {
        _parentLetter = _sampleLetters[_parentLang] ?? _sampleLetters['English'];
      }
      if (mounted) setState(() => _isLoadingParent = false);
    }
  }

  Future<void> _fetchData() async {
    setState(() => _isLoadingData = true);
    try {
      final r = await Future.wait([
        http.get(Uri.parse('${widget.baseUrl}/api/students/${widget.studentId}/progress')),
        http.get(Uri.parse('${widget.baseUrl}/api/path/${widget.studentId}')),
      ]);
      if (r[0].statusCode == 200) _progress = jsonDecode(r[0].body) as Map<String, dynamic>;
      if (r[1].statusCode == 200) _path = jsonDecode(r[1].body) as Map<String, dynamic>;
    } catch (e) {
      debugPrint('Error loading report data: $e');
    } finally {
      // Prototype data so the report is never empty in a demo (real data replaces it as soon as it exists).
      if (_quizzes.isEmpty && _labs.isEmpty) _progress = _demoProgress();
      if (_days.isEmpty) _path = _demoPath();
      if (mounted) setState(() => _isLoadingData = false);
    }
  }

