    final textTheme = Theme.of(context).textTheme;

    return LayoutBuilder(builder: (context, constraints) {
      final isNarrow = constraints.maxWidth < 750;
      final pad = isNarrow ? tokens.space16 : tokens.space32;
      final cardPad = EdgeInsets.all(isNarrow ? tokens.space16 : tokens.space24);
      final s = _summary;

      Widget title(IconData i, String t, Color c) => Row(children: [
            Icon(i, color: c, size: 20),
            SizedBox(width: tokens.space8),
            Expanded(child: Text(t, style: textTheme.titleMedium)),
