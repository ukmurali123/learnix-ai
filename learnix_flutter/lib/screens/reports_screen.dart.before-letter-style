  void _openPrint(String doc) {
    final blob = html.Blob([doc], 'text/html');
    final url = html.Url.createObjectUrlFromBlob(blob);
    html.window.open(url, '_blank');
    ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Opened in a new tab. In the print window choose "Save as PDF".')));
  }

